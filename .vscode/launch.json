{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [

        {
            "name": "Run compiler [tui]",
            "type": "debugpy",
            "request": "launch",
            "module": "src.compiler",
            "console": "integratedTerminal",
            "args": [
                "./code.ml",
                "--log"
            ],
            "cwd": "${workspaceFolder}",
            "presentation": {
                "hidden": false,
                "group": "compiler",
            },
        },

        {
            "name": "Run compiler [no tui]",
            "type": "debugpy",
            "request": "launch",
            "module": "src.compiler",
            "console": "integratedTerminal",
            "args": "./code.ml",
            "cwd": "${workspaceFolder}",
            "presentation": {
                "hidden": false,
                "group": "compiler",
            },
        },

        {
            "name": "Run compiler [gen output]",
            "type": "debugpy",
            "request": "launch",
            "module": "src.compiler",
            "console": "integratedTerminal",
            "args": [
                "./code.ml",
                "--log",
                "./output.py"
            ],
            "cwd": "${workspaceFolder}",
            "presentation": {
                "hidden": false,
                "group": "compiler",
            },
        },

        {
            "name": "Run compiler [hybrid interpreter]",
            "type": "debugpy",
            "request": "launch",
            "module": "src.compiler",
            "console": "integratedTerminal",
            "args": [
                "./code.ml",
                "--log",
                "./output.py",
                "--interpreter"
            ],
            "cwd": "${workspaceFolder}",
            "presentation": {
                "hidden": false,
                "group": "compiler",
            },
        },

        {
            "name": "Test sample",
            "type": "debugpy",
            "request": "launch",
            "module": "src.compiler",
            "console": "integratedTerminal",
            "args": [
                "${input:sample}",
                "./output.py",
                "--log",
                "--interpreter"
            ],
            "presentation": {
                "hidden": false,
                "group": "compiler"
            },
        },

        {
            "name": "Run module [debug]",
            "type": "debugpy",
            "request": "launch",
            "module": "${input:module}",
            "console": "integratedTerminal",
            "args": [
                "./code.ml",
                "--log",
                "--debug-compiler"
            ],
            "cwd": "${workspaceFolder}",
            "presentation": {
                "hidden": false,
                "group": "module",
            }
        },

        {
            "name": "Run module [no tui]",
            "type": "debugpy",
            "request": "launch",
            "module": "${input:module}",
            "console": "integratedTerminal",
            "args": "./code.ml",
            "cwd": "${workspaceFolder}",
            "presentation": {
                "hidden": false,
                "group": "module",
            },
        },

        {
            "name": "Python compiler [stop on ...]",
            "type": "debugpy",
            "request": "launch",
            "module": "src.compiler",
            "console": "integratedTerminal",
            "args": [
                "./code.ml",
                "${input:stop}",
                "--log"
            ],
            "presentation": {
                "hidden": false,
                "group": "stop",
            }
        },

    ],
    "inputs": [
        {
            "id": "module",
            "description": "Module to debug",
            "type": "pickString",
            "default": "src.compiler",
            "options": [
                "src.compiler",
                "src.modules.lexer",
                "src.modules.parser",
                "src.modules.gen",
                "src.modules.symbols",
                "src.utils.interpreter",
                "src.utils.tui"
            ]
        },
        {
            "id": "stop",
            "description": "Stop on",
            "type": "pickString",
            "default": "--lexer",
            "options": [
                "--lexer",
                "--parser",
                "--interpreter"
            ]
        },
        {
            "id": "sample",
            "description": "Sample",
            "type": "pickString",
            "default": "./code.ml",
            "options": [
                "./code.ml",
                "./samples/err1.ml",
                "./samples/err2.ml",
                "./samples/err3.ml",
                "./samples/err4.ml",
                "./samples/err5.ml",
                "./samples/err6.ml",
                "./samples/err7.ml",
                "./samples/err8.ml",
                "./samples/err9.ml",
                "./samples/err10.ml",
                "./samples/err11.ml",
                "./samples/err12.ml",
                "./samples/err13.ml",
                "./samples/err14.ml",
                "./samples/err15.ml",
                "./samples/suc1.ml",
                "./samples/suc2.ml",
                "./samples/suc3.ml",
                "./samples/suc4.ml",
                "./samples/suc5.ml",
                "./samples/suc6.ml",
                "./samples/suc7.ml",
                "./samples/suc8.ml",
                "./samples/suc9.ml",
                "./samples/suc10.ml",
            ]
        }
    ]
}
