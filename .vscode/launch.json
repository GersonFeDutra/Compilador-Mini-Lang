{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python Debugger [pick arguments]",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/src//compiler.py",
            "console": "integratedTerminal",
            "args": "${command:pickArgs}"
        },

        {
            "name": "Python Debugger [no log]",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/src/compiler.py",
            "console": "integratedTerminal",
            "args": "./code.ml",
            "presentation": {
                "hidden": false,
                "group": "debug",
                "order": 1
            },
        },

        {
            "name": "Python Debugger",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/src/compiler.py",
            "console": "integratedTerminal",
            "args": [
                "./code.ml",
                "--log"
            ],
            "presentation": {
                "hidden": false,
                "group": "debug",
                "order": 1
            },
        },

        {
            "name": "Python Debugger [gen output]",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/src/compiler.py",
            "console": "integratedTerminal",
            "args": [
                "./code.ml",
                "--log",
                "./output.py"
            ],
            "presentation": {
                "hidden": false,
                "group": "debug",
                "order": 1
            },
        },

        {
            "name": "Python Debugger [hybrid interpreter]",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/src/compiler.py",
            "console": "integratedTerminal",
            "args": [
                "./code.ml",
                "--log",
                "./output.py",
                "--interpreter"
            ],
            "presentation": {
                "hidden": false,
                "group": "debug",
                "order": 1
            },
        },

        {
            "name": "Python Debugger [file]",
            "type": "debugpy",
            "request": "launch",
            //"module": "utils.tui",  // Use 'module' instead of 'program'
            "module": "utils.interpreter",
            "console": "integratedTerminal",
            "args": [
                "../code.ml",
                "--log",
                "--debug-compiler"
            ],
            "cwd": "${workspaceFolder}/src", // Set the current working directory
            "presentation": {
                "hidden": false,
                "group": "debug",
                "order": 1
            }
        },


        {
            "name": "Python Debugger [stop on lexer]",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/src/compiler.py",
            "console": "integratedTerminal",
            "args": [
                "./code.ml",
                "--lexer",
                "--log"
            ],
            "presentation": {
                "hidden": false,
                "group": "debug",
                "order": 1
            }
        },

        {
            "name": "Python Debugger [current file]",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "args": "./code.ml",
            "presentation": {
                "hidden": false,
                "group": "debug",
                "order": 1
            },
            "cwd": "${workspaceFolder}/src/"
        },
    ]
}
